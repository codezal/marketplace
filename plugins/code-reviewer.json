{
  "name": "code-reviewer",
  "version": "0.3.0",
  "description": "Codezal code-review plugin. /review is a quick single-pass review; /review-deep is a multi-perspective audit with confidence scoring, CLAUDE.md compliance, git history, and (optional) PR comment posting. Opt-in proactive hook suggests a review after edits.",
  "channel": "codezal-curated",
  "verified": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Codezal",
    "url": "https://github.com/codezal"
  },
  "upstream": "https://github.com/codezal/marketplace/tree/main/plugins-inline/code-reviewer",
  "permissions": [
    "filesystem.read",
    "git.exec",
    "shell.exec",
    "agents.register",
    "commands.register",
    "hooks.register"
  ],
  "contributes": {
    "agents": [
      "agents/*.md"
    ],
    "commands": [
      "commands/*.md"
    ],
    "hooks": [
      {
        "source": "hooks/hooks.json"
      }
    ]
  },
  "source": {
    "type": "inline",
    "path": "plugins-inline/code-reviewer"
  },
  "requires": {
    "codezalMinVersion": "0.1.0"
  },
