{
  "name": "code-reviewer",
  "version": "0.2.0",
  "description": "Codezal kod-review eklentisi. /review hızlı tek-pass; /review-deep multi-perspective + confidence scoring + CLAUDE.md compliance + git history + PR yorum post (onaylı).",
  "channel": "codezal-curated",
  "verified": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Codezal",
    "url": "https://github.com/codezal"
  },
  "upstream": "https://github.com/codezal/marketplace/tree/main/plugins-inline/code-reviewer",
  "permissions": [
    "filesystem.read",
    "git.exec",
    "shell.exec",
    "agents.register",
    "commands.register"
  ],
  "contributes": {
    "agents": ["agents/*.md"],
    "commands": ["commands/*.md"]
  },
  "source": {
    "type": "inline",
    "path": "plugins-inline/code-reviewer"
  },
  "requires": {
    "codezalMinVersion": "0.1.0"
  }
}
